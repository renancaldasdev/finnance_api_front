#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Quality checks before commit
echo "🔍 Running code quality checks..."

# Format code and fix linting in parallel
npm run format &
npm run lint:fix &
wait

# Run tests (after format+lint complete)
npm run test
TEST_RESULT=$?

# Check if there are linting errors (not warnings)
LINT_OUTPUT=$(npm run lint 2>&1)
if echo "$LINT_OUTPUT" | grep -E "✖ [0-9]+ problems \([1-9][0-9]* error"; then
  echo "❌ Linting errors found. Please fix them manually."
  exit 1
fi

if [ $TEST_RESULT -ne 0 ]; then
  echo "❌ Tests failed. Please fix them before committing."
  exit 1
fi

echo "✅ All quality checks passed!"
