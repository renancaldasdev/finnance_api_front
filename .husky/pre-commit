#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Quality checks before commit
echo "🔍 Running code quality checks..."

# Format code
npm run format

# Fix linting issues
npm run lint:fix

# Run tests
npm run test

# Check if there are still issues after fixes
if npm run lint 2>&1 | grep -E "error"; then
  echo "❌ Linting errors found. Please fix them manually."
  exit 1
fi

echo "✅ All quality checks passed!"
